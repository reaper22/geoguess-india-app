<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gg_surface" />
            <stroke android:width="1dp" android:color="@color/gg_outline" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:width="24dp"
        android:height="24dp"
        android:drawable="@drawable/ic_arrow_drop"
        android:end="12dp"
        android:gravity="center_vertical|end" />
</layer-list>